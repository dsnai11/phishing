# Copy to .env for local development (never commit the real .env)

# Neon connection string (Neon Console → your project → Connect → copy the connection string)
# Example format:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# SSL is switched on automatically for Neon. Only set to false for a local Postgres without SSL.
# DATABASE_SSL=false

# Admin dashboard login (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Pass mark in percent (keep in sync with CONFIG.passMark in public/index.html)
PASS_MARK=80
# Optional: different pass mark for the advanced (CISA-level) module
# PASS_MARK_ADVANCED=70

# Proctoring (defaults shown). Keep in sync with CONFIG in public/basic.html and public/advanced.html
# TIME_LIMIT_BASIC_MIN=0
# TIME_LIMIT_ADVANCED_MIN=30
# MAX_WARNINGS=2

# Webcam photos are deleted automatically after this many days (0 = keep forever)
# SNAPSHOT_RETENTION_DAYS=180

# Optional: other websites (e.g. your LMS) allowed to submit results, comma-separated
ALLOWED_ORIGINS=

PORT=3000
